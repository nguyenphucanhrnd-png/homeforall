# Copy to .env.local and fill in. Never commit real values.

# Public site origin (used for magic-link redirects and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Singapore region) → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by scripts (dev users, demo seed). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Dev only: allow scripts/dev-role-users.ts to create demo users with login links.
HFA_ALLOW_DEV_USERS=false

# Serve /dev/* pages in a production build (keep false in production).
ENABLE_DEV_PAGES=false

# M1: Cloudflare Turnstile for public forms
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
